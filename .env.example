# Base URL of the backend's public API (Globe stats, featured payouts,
# featured certificates). Include the /api/v1 prefix, no trailing slash.
# Example: VITE_API_BASE_URL=https://api.your-domain.com/api/v1
# If left unset, falls back to https://rewards.fundingyourtrades.com/api/v1.
# Vite inlines this at BUILD time — set it before `npm run build`, not after.
VITE_API_BASE_URL=
